<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-check of the plugin's real sources against stub AutoCAD types.
       Catches C# errors in our logic; says nothing about the real API. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IsoTidyStubCheck</AssemblyName>
    <RootNamespace>IsoTidy</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <Compile Include="..\src\*.cs" />
  </ItemGroup>
</Project>
