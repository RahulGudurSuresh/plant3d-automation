{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "isotidypy: tidy a drawing (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "isotidypy.cli",
      "args": ["${input:dwgPath}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "dwgPath",
      "type": "promptString",
      "description": "Path to a .dwg file"
    }
  ]
}
